# Clé de signature des JWT (obligatoire) : openssl rand -hex 32
SECRET_KEY=change-me
# Port exposé sur l'hôte (défaut 18420)
APP_PORT=18420
# Compte administrateur (onglet Administration) : email et mot de passe
ADMIN_EMAIL=
ADMIN_PASSWORD=
# URL publique du site, utilisée dans les emails de réinitialisation de mot de passe
PUBLIC_URL=
