{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"types": ["node", "$app/types"],
		"paths": {
			"$lib": ["src/lib"],
			"$lib/*": ["src/lib/*"],
			"#lib": ["src/lib"],
			"#lib/*": ["src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker.ts"]
}
